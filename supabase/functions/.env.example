# Local Edge Function secrets for Prismatix.
# Copy to supabase/functions/.env (ignored by git) and fill real values.
# Never commit .env, and never expose the service-role key to the Vite client.
#
# For the local stack, SUPABASE_URL is http://127.0.0.1:54321 and the
# service-role key is the local demo key printed by `npm run supabase:status`.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<set-me-local-or-staging-service-role-key>
OPENAI_API_KEY=<set-me>
VIDEO_WORKER_SECRET=<set-me>

# Optional routing and budget controls (safe defaults are fine locally).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENCODE_BASE_URL=
ALLOWED_ORIGIN=http://localhost:5173
DEV_MODE=true
USER_RATE_LIMIT_MAX_REQUESTS=30
USER_RATE_LIMIT_WINDOW_MS=60000
PER_REQUEST_COST_LIMIT_USD=0.50
DAILY_SPEND_LIMIT_USD=5.00
