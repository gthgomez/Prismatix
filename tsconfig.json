{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Deno-style npm: specifiers used by supabase/functions modules that are
       type-checked through test imports (resolved natively by Deno, and by the
       deno-npm-stubs vite plugin at vitest runtime). */
    "paths": {
      "npm:@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Additional type safety */
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "tests"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
