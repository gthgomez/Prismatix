# Supabase Project
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Router Edge Function endpoint
VITE_ROUTER_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/router

# Feature flags
VITE_ENABLE_VIDEO_PIPELINE=false

# PX01: gate the signup UI (default off; signups disabled until beta
# readiness). Server-side signup settings must be verified separately --
# config.toml is NOT proof of production auth settings.
VITE_ALLOW_SIGNUP=false

# NOTE: Server-side provider credentials (e.g. OPENCODE_API_KEY, optional
# OPENCODE_BASE_URL) are NOT frontend env vars. They are Supabase edge
# function secrets set via `supabase secrets set` -- see README.md
# ("First-time setup"). Never put real API keys in this file.
