# Staging/browser-test configuration for Prismatix.
# Copy to .env.local and fill real staging values. Never commit .env.local.
#
# Do not reuse the production project. Use a distinct staging project and a
# publishable/anon key only; the service-role key belongs in
# supabase/functions/.env, never in VITE_* variables.

VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<staging-publishable-or-anon-key>
VITE_ROUTER_ENDPOINT=https://<staging-project-ref>.supabase.co/functions/v1/router
VITE_ENABLE_VIDEO_PIPELINE=false
VITE_ALLOW_SIGNUP=false

# Local alternative:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<local anon key from `npm run supabase:status`>
# VITE_ROUTER_ENDPOINT=http://127.0.0.1:54321/functions/v1/router
