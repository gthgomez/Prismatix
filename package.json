{
  "name": "prismatix",
  "version": "0.2.0-pre.1",
  "private": true,
  "description": "Intelligent multi-provider AI model router with streaming, cost tracking, and debate mode",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx",
    "test": "vitest run",
    "audit:models": "node scripts/audit-stale-models.mjs",
    "check:parity": "node scripts/check-deployment-parity.mjs",
    "supabase:start": "npx --yes supabase@2.114.0 start",
    "supabase:stop": "npx --yes supabase@2.114.0 stop",
    "supabase:status": "npx --yes supabase@2.114.0 status",
    "supabase:reset": "npx --yes supabase@2.114.0 db reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "keywords": [
    "prismatix",
    "anthropic",
    "ai",
    "chatbot",
    "router",
    "streaming",
    "react"
  ]
}
